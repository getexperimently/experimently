{
  "name": "@experimentation-platform/js-sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript SDK for the Experimentation Platform public API (Node >= 18 and browsers, zero runtime dependencies)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "smoke": "npm run build --silent && node examples/contract_smoke.mjs"
  },
  "keywords": [
    "experimentation",
    "feature-flags",
    "ab-testing",
    "javascript",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
