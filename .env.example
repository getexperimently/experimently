# Development settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/experimentation
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=experimentation
REDIS_HOST=localhost
REDIS_PORT=6379
AWS_PROFILE=experimentation-dev
AWS_REGION=us-east-1
# Signs local-provider JWTs; must be >= 32 chars in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development_secret_key_change_in_production
# One of: development | test | staging | production  (legacy APP_ENV / dev / prod
# are still accepted with a deprecation warning)
ENVIRONMENT=development

# --- Authentication -----------------------------------------------------------
# local   = e-mail + password against the users table (the default)
# cognito = AWS Cognito (also needs COGNITO_USER_POOL_ID and COGNITO_CLIENT_ID)
AUTH_PROVIDER=local
# Serve every request as a synthetic dev-admin superuser WITHOUT credentials.
# Only honoured when ENVIRONMENT is development or test; the API refuses to
# start with this set in staging/production. Keep it false unless you know why.
DEV_AUTH_BYPASS=false
# Local-provider token lifetime and brute-force lockout (per e-mail address,
# in-process counter: run one worker or accept per-worker counters)
LOCAL_AUTH_TOKEN_TTL_MINUTES=720
LOCAL_AUTH_MAX_FAILED_ATTEMPTS=10
LOCAL_AUTH_LOCKOUT_MINUTES=15
# Created by `python -m backend.app.db.bootstrap` when the users table is empty
FIRST_SUPERUSER=admin@demo.com
FIRST_SUPERUSER_PASSWORD=Demo1234!
# Per-IP ceiling for SDK traffic (/api/v1/tracking/*, flag evaluation); default 6000/min
# SDK_RATE_LIMIT_PER_MINUTE=6000
# Background job cadences (minutes); the demos run them faster than production defaults
# BANDIT_UPDATE_INTERVAL_MINUTES=5
# SAFETY_CHECK_INTERVAL_MINUTES=5
# ROLLOUT_CHECK_INTERVAL_MINUTES=15
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3100,http://localhost:3200,http://localhost:3300,http://localhost:8000

# Whose X-Forwarded-* headers the server believes. Leave this unset unless the
# topology needs it: the default trusts loopback and the RFC1918 ranges, which
# covers any load balancer (always inside the VPC, always private) without this
# container having to know its own VPC's CIDR.
#
# It decides both the request scheme and the client address, and the rate
# limiter keys its buckets on the latter -- so trusting everybody (the old
# `*`) let a client mint a fresh bucket per request by prepending a random
# address, including against the strict login limit (#237).
#
# Getting it WRONG in the other direction is the failure to watch for: a list
# that does not contain the proxy makes uvicorn ignore the headers entirely,
# every client then appears to be the proxy, and the rate limiter silently
# collapses to one shared bucket.
FORWARDED_ALLOW_IPS=

# The canonical absolute URL this service is reached at, e.g.
# https://api.example.com -- scheme and host, no path, no trailing slash.
#
# Absolute URLs the app EMITS are built from this instead of from the request,
# so no handler asks the request for the application's own identity. The OIDC
# redirect_uri is the one that mattered (#220): it is the address an
# authorization code comes back to, and it was built from the Host header,
# which is attacker-controlled.
#
# Also the fix for the ordinary case behind a TLS-terminating proxy, where the
# request's own scheme is http and every absolute URL built from it is wrong.
#
# Unset falls back to the request, which is the development default.
PUBLIC_BASE_URL=

# The hostnames this service answers to. Usually LEAVE THIS UNSET: when it is
# empty it derives from PUBLIC_BASE_URL's host, which is the URL users actually
# reach the service at and therefore a host we answer to by definition. Set it
# only when the service legitimately answers on several names.
#
# Comma-separated. A leading `*.` is a subdomain wildcard and does NOT match
# the bare apex. A pattern that can never match -- `*example.com` without its
# dot, say -- is refused rather than accepted, because a deployment configured
# with one refuses every request while the exempt health probes stay green.
#
# Staging and production refuse to start with neither this nor PUBLIC_BASE_URL
# set, and refuse `*` here outright.
ALLOWED_HOSTS=

# Bandit weight refresh cadence for MAB experiments (minutes)
BANDIT_UPDATE_INTERVAL_MINUTES=5
# Optional: fixed API key for the ShopLab demo storefront (generated when unset)
# SHOPLAB_API_KEY=

# ---------------------------------------------------------------------------
# Claude / Anthropic
# ---------------------------------------------------------------------------
# The model the platform's own AI features call (experiment design, the
# planner). Changing it needs no code edit -- three services carried the model
# as a literal and were still a generation behind because of it.
ANTHROPIC_MODEL=claude-sonnet-5
# The default judge for LLM-as-judge scoring; a request may override it.
LLM_DEFAULT_JUDGE_MODEL=claude-sonnet-5
