# Repository-root build context (backend/Dockerfile, demo/*/Dockerfile).
# Keep the context small: everything below is never needed inside an image.
.git/
.github/
.claude/
.vscode/
.idea/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/htmlcov/
**/.coverage
**/coverage.xml
venv/
.venv/
**/*.egg-info/
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/tsconfig.tsbuildinfo
.env
.env.*
!.env.example
**/.env.local
**/*.log
**/.DS_Store
# docs/ is copied into the dashboard image (in-app documentation pages).
public-preview/
infrastructure/
backend/tests/
backend/lambda/
tests/
sdk/*/node_modules/
sdk/*/dist/
sdk/android/
sdk/ios/
sdk/java/
sdk/dotnet/
sdk/elixir/
sdk/flutter/
sdk/go/
sdk/php/
sdk/ruby/
sdk/python/
demo/.pids/
demo/.logs/
demo/**/.api_key
