{
  "name": "experimently-frontend",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --watchAll=false --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test visual-regression",
    "test:visual:update": "playwright test visual-regression --update-snapshots",
    "test:a11y": "playwright test accessibility",
    "openapi:dump": "cd .. && python -m backend.scripts.dump_openapi frontend/src/tests/fixtures/openapi.json"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.25",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.3.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0"
  }
}
